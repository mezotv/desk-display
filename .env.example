# Create a restricted Stripe key with read access to Subscriptions and Prices.
STRIPE_SECRET_KEY=rk_live_replace_me

# Optional. If omitted, the dashboard selects the largest detected currency.
DISPLAY_CURRENCY=eur

# Optional display personalization. The public defaults are English and no name.
DISPLAY_LANGUAGE=en
DISPLAY_NAME=

# Optional weather location. If omitted, the open-source default is Berlin.
# Example for Berlin:
WEATHER_LATITUDE=52.5200
WEATHER_LONGITUDE=13.4050
WEATHER_LOCATION_LABEL=Berlin

# Optional Spotify integration. Authorize after adding these values.
SPOTIFY_CLIENT_ID=replace_me
SPOTIFY_CLIENT_SECRET=replace_me

# Optional Google Calendar integration. Create a Web application OAuth client
# with this redirect URI:
# http://127.0.0.1:3000/api/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace_me

# Optional read-only X integration. Enter the username without @.
X_USERNAME=replace_me
X_BEARER_TOKEN=replace_me

# Refresh tokens are written here automatically after the in-app OAuth flow.
# Never commit a real .env file.
