# Desk Display runs without integrations. Add only the services you use.
STRIPE_SECRET_KEY=
DISPLAY_CURRENCY=USD
DISPLAY_LANGUAGE=en
DISPLAY_NAME=

# Optional override for the physical Display app.
DESK_DISPLAY_BACKLIGHT_DIRECTORY=/sys/class/backlight/10-0045
DESK_DISPLAY_OUTPUT_NAME=

# Berlin is the public example location.
WEATHER_LATITUDE=52.5200
WEATHER_LONGITUDE=13.4050
WEATHER_LOCATION_LABEL=Berlin

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

X_USERNAME=
X_BEARER_TOKEN=

# Optional Mac bridge for Codex and Claude usage. Both values are required.
AGENT_USAGE_BRIDGE_URL=
AGENT_USAGE_BRIDGE_TOKEN=
