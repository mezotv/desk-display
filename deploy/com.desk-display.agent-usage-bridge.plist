<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.desk-display.agent-usage-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__BRIDGE_PATH__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__BRIDGE_PATH_ENVIRONMENT__</string>
    <key>DESK_DISPLAY_BRIDGE_HOST</key>
    <string>0.0.0.0</string>
    <key>DESK_DISPLAY_BRIDGE_PORT</key>
    <string>4747</string>
    <key>DESK_DISPLAY_BRIDGE_TOKEN_FILE</key>
    <string>__TOKEN_PATH__</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__STDOUT_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__STDERR_PATH__</string>
</dict>
</plist>
