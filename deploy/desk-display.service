[Unit]
Description=Desk Display
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=display
Group=display
WorkingDirectory=/home/display/desk-display
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DESK_DISPLAY_ROOT=/home/display/desk-display
EnvironmentFile=-/home/display/desk-display/.env
ExecStart=/usr/bin/node /home/display/desk-display/.output/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
