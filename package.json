{
  "name": "desk-display",
  "version": "0.6.1",
  "description": "A pixel-art Raspberry Pi desk display for Stripe, Spotify, weather, calendars, alarms, and system status.",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "./scripts/install-effect-skills.sh",
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/doto": "5.3.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "effect": "4.0.0-beta.102",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
